{
  "name": "@hermes/center-geo",
  "version": "0.1.0",
  "description": "CENTER-MULTIGEOMETRY: deterministic multi-geometry structural risk scanner. Companion to center-audit.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli/main.js"
  },
  "bin": {
    "center-geo": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node scripts/clean.mjs",
    "rebuild": "npm run clean && npm run build",
    "start": "node dist/cli/main.js",
    "dev": "tsx src/cli/main.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "center-geo": "node dist/cli/main.js"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/picomatch": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
